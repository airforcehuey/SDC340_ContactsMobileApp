<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Brendan Tice - Contacts Address Book"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#17365D"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#17365D"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alex Carter"
        android:textSize="22sp"
        android:textColor="#222222"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnContactOne"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Alex Carter Details"
        android:layout_marginBottom="28dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Amanda Brooks"
        android:textSize="22sp"
        android:textColor="#222222"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnContactTwo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Amanda Brooks Details" />

</LinearLayout>
